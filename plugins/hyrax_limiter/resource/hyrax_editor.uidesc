<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
	<fonts/>
	<bitmaps>
		<bitmap name="GainReductionMeter" path="GainReductionMeter.png"/>
	</bitmaps>
	<colors>
		<color name="PanelBack" rgba="#1e1e20ff"/>
		<color name="SliderBack" rgba="#2a2a2eff"/>
		<color name="SliderValue" rgba="#5ac878ff"/>
		<color name="SliderFrame" rgba="#46464aff"/>
		<color name="EditBack" rgba="#101012ff"/>
		<color name="EditFrame" rgba="#46464aff"/>
		<color name="TextColor" rgba="#c8c8ccff"/>
		<color name="TitleColor" rgba="#ffffffff"/>
		<color name="Accent" rgba="#5ac878ff"/>
	</colors>
	<template background-color="PanelBack" background-color-draw-style="filled" class="CViewContainer" minSize="430, 360" maxSize="430, 360" name="view" origin="0, 0" size="430, 360">

		<!-- Title + bypass -->
		<view class="CTextLabel" title="Hyrax Limiter" font="~ NormalFontVeryBig" font-color="TitleColor" text-alignment="left" transparent="true" origin="12, 10" size="260, 26"/>
		<view class="CCheckBox" control-tag="Bypass" title="Bypass" font="~ NormalFontSmall" font-color="TextColor" boxframe-color="SliderFrame" boxfill-color="EditBack" checkmark-color="Accent" origin="330, 13" size="90, 20"/>

		<!-- Gain reduction meters (analog VU style, one per channel) -->
		<view class="CTextLabel" title="GAIN REDUCTION" font="~ NormalFontSmall" font-color="TextColor" text-alignment="center" transparent="true" origin="77, 44" size="276, 16"/>
		<view class="CView" custom-view-name="HyraxGRMeter" channel="L" mouse-enabled="false" origin="77, 64" size="128, 94"/>
		<view class="CView" custom-view-name="HyraxGRMeter" channel="R" mouse-enabled="false" origin="225, 64" size="128, 94"/>
		<view class="CTextLabel" title="L" font="~ NormalFontSmall" font-color="TextColor" text-alignment="center" transparent="true" origin="77, 159" size="128, 16"/>
		<view class="CTextLabel" title="R" font="~ NormalFontSmall" font-color="TextColor" text-alignment="center" transparent="true" origin="225, 159" size="128, 16"/>

		<!-- Threshold -->
		<view class="CTextLabel" title="Threshold" font="~ NormalFont" font-color="TextColor" text-alignment="left" transparent="true" origin="12, 190" size="90, 20"/>
		<view class="CView" custom-view-name="HyraxSlider" control-tag="Threshold" mouse-enabled="true" origin="104, 191" size="196, 18"/>
		<view class="CTextEdit" control-tag="Threshold" font="~ NormalFontSmall" font-color="TextColor" back-color="EditBack" frame-color="EditFrame" text-alignment="center" value-precision="1" style-round-rect="true" round-rect-radius="4" origin="308, 191" size="66, 18"/>
		<view class="CTextLabel" title="dB" font="~ NormalFontSmall" font-color="TextColor" text-alignment="left" transparent="true" origin="380, 191" size="40, 18"/>

		<!-- Ceiling -->
		<view class="CTextLabel" title="Ceiling" font="~ NormalFont" font-color="TextColor" text-alignment="left" transparent="true" origin="12, 218" size="90, 20"/>
		<view class="CView" custom-view-name="HyraxSlider" control-tag="Ceiling" mouse-enabled="true" origin="104, 219" size="196, 18"/>
		<view class="CTextEdit" control-tag="Ceiling" font="~ NormalFontSmall" font-color="TextColor" back-color="EditBack" frame-color="EditFrame" text-alignment="center" value-precision="1" style-round-rect="true" round-rect-radius="4" origin="308, 219" size="66, 18"/>
		<view class="CTextLabel" title="dB" font="~ NormalFontSmall" font-color="TextColor" text-alignment="left" transparent="true" origin="380, 219" size="40, 18"/>

		<!-- Look Ahead -->
		<view class="CTextLabel" title="Look Ahead" font="~ NormalFont" font-color="TextColor" text-alignment="left" transparent="true" origin="12, 246" size="90, 20"/>
		<view class="CView" custom-view-name="HyraxSlider" control-tag="LookAhead" mouse-enabled="true" origin="104, 247" size="196, 18"/>
		<view class="CTextEdit" control-tag="LookAhead" font="~ NormalFontSmall" font-color="TextColor" back-color="EditBack" frame-color="EditFrame" text-alignment="center" value-precision="0" style-round-rect="true" round-rect-radius="4" origin="308, 247" size="66, 18"/>
		<view class="CTextLabel" title="ms" font="~ NormalFontSmall" font-color="TextColor" text-alignment="left" transparent="true" origin="380, 247" size="40, 18"/>

		<!-- Release -->
		<view class="CTextLabel" title="Release" font="~ NormalFont" font-color="TextColor" text-alignment="left" transparent="true" origin="12, 274" size="90, 20"/>
		<view class="CView" custom-view-name="HyraxSlider" control-tag="Release" mouse-enabled="true" origin="104, 275" size="196, 18"/>
		<view class="CTextEdit" control-tag="Release" font="~ NormalFontSmall" font-color="TextColor" back-color="EditBack" frame-color="EditFrame" text-alignment="center" value-precision="0" style-round-rect="true" round-rect-radius="4" origin="308, 275" size="66, 18"/>
		<view class="CTextLabel" title="ms" font="~ NormalFontSmall" font-color="TextColor" text-alignment="left" transparent="true" origin="380, 275" size="40, 18"/>

		<!-- Stereo Link -->
		<view class="CTextLabel" title="Stereo Link" font="~ NormalFont" font-color="TextColor" text-alignment="left" transparent="true" origin="12, 302" size="90, 20"/>
		<view class="CView" custom-view-name="HyraxSlider" control-tag="StereoLink" mouse-enabled="true" origin="104, 303" size="196, 18"/>
		<view class="CTextEdit" control-tag="StereoLink" font="~ NormalFontSmall" font-color="TextColor" back-color="EditBack" frame-color="EditFrame" text-alignment="center" value-precision="0" style-round-rect="true" round-rect-radius="4" origin="308, 303" size="66, 18"/>
		<view class="CTextLabel" title="%" font="~ NormalFontSmall" font-color="TextColor" text-alignment="left" transparent="true" origin="380, 303" size="40, 18"/>

		<!-- True Peak -->
		<view class="CTextLabel" title="True Peak" font="~ NormalFont" font-color="TextColor" text-alignment="left" transparent="true" origin="12, 332" size="90, 20"/>
		<view class="CCheckBox" control-tag="TruePeak" title="" font="~ NormalFontSmall" font-color="TextColor" boxframe-color="SliderFrame" boxfill-color="EditBack" checkmark-color="Accent" origin="104, 332" size="20, 20"/>

	</template>
	<custom>
		<attributes name="UIDescFilePath" path="hyrax_editor.uidesc"/>
	</custom>
	<control-tags>
		<control-tag name="Threshold" tag="0"/>
		<control-tag name="Ceiling" tag="1"/>
		<control-tag name="LookAhead" tag="2"/>
		<control-tag name="Release" tag="3"/>
		<control-tag name="StereoLink" tag="4"/>
		<control-tag name="TruePeak" tag="5"/>
		<control-tag name="Bypass" tag="6"/>
	</control-tags>
</vstgui-ui-description>
