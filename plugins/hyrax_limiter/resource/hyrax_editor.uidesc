<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
	<fonts/>
	<bitmaps>
		<bitmap name="Background" path="hyrax_front_panel_moog.png"/>
		<bitmap name="GainReductionMeter" path="GainReductionMeter.png"/>
		<bitmap name="KnobBig" path="Knob_Minimoog_Big.png" multiframe-size="110, 110" multiframe-num-frames="31" mulitframe-frames-per-row="1"/>
		<bitmap name="KnobSmall" path="Knob_Minimoog_Small.png" multiframe-size="110, 110" multiframe-num-frames="31" mulitframe-frames-per-row="1"/>
		<bitmap name="BypassButton" path="BypassButton.png"/>
		<bitmap name="TruePeakButton" path="TruePeakButton.png"/>
	</bitmaps>
	<colors>
		<color name="PanelBack" rgba="#1e1e20ff"/>
		<color name="EditBack" rgba="#101012ff"/>
		<color name="EditFrame" rgba="#46464aff"/>
		<color name="TextColor" rgba="#e6e6e6ff"/>
	</colors>
	<template background-color="PanelBack" background-color-draw-style="filled" bitmap="Background" class="CViewContainer" minSize="849, 351" maxSize="849, 351" name="view" origin="0, 0" size="849, 351">

		<!-- Gain reduction meters (analog VU, one per channel) over the baked-in backplate -->
		<view class="CView" custom-view-name="HyraxGRMeter" channel="L" mouse-enabled="false" origin="389, 38" size="128, 94"/>
		<view class="CView" custom-view-name="HyraxGRMeter" channel="R" mouse-enabled="false" origin="520, 38" size="128, 94"/>

		<!-- Big knobs: Threshold, Ceiling -->
		<view class="HyraxKnob" control-tag="Threshold" bitmap="KnobBig" origin="102, 50" size="110, 110"/>
		<view class="HyraxKnob" control-tag="Ceiling" bitmap="KnobBig" origin="103, 219" size="110, 110"/>

		<!-- Small knobs: Look Ahead, Release, Stereo Link -->
		<view class="HyraxKnob" control-tag="LookAhead" bitmap="KnobSmall" origin="354, 178" size="110, 110"/>
		<view class="HyraxKnob" control-tag="Release" bitmap="KnobSmall" origin="463, 177" size="110, 110"/>
		<view class="HyraxKnob" control-tag="StereoLink" bitmap="KnobSmall" origin="573, 178" size="110, 110"/>

		<!-- Toggle buttons: Bypass (red), True Peak (green) -->
		<view class="COnOffButton" control-tag="Bypass" bitmap="BypassButton" origin="715, 61" size="50, 30"/>
		<view class="COnOffButton" control-tag="TruePeak" bitmap="TruePeakButton" origin="271, 217" size="50, 30"/>

		<!-- Editable value readouts under each knob (units are baked into the panel) -->
		<view class="CTextEdit" control-tag="Threshold" font="~ NormalFontSmall" font-color="TextColor" back-color="EditBack" frame-color="EditFrame" text-alignment="center" value-precision="1" style-round-rect="true" round-rect-radius="4" origin="129, 159" size="56, 16"/>
		<view class="CTextEdit" control-tag="Ceiling" font="~ NormalFontSmall" font-color="TextColor" back-color="EditBack" frame-color="EditFrame" text-alignment="center" value-precision="1" style-round-rect="true" round-rect-radius="4" origin="130, 328" size="56, 16"/>
		<view class="CTextEdit" control-tag="LookAhead" font="~ NormalFontSmall" font-color="TextColor" back-color="EditBack" frame-color="EditFrame" text-alignment="center" value-precision="0" style-round-rect="true" round-rect-radius="4" origin="386, 280" size="46, 15"/>
		<view class="CTextEdit" control-tag="Release" font="~ NormalFontSmall" font-color="TextColor" back-color="EditBack" frame-color="EditFrame" text-alignment="center" value-precision="0" style-round-rect="true" round-rect-radius="4" origin="495, 280" size="46, 15"/>
		<view class="CTextEdit" control-tag="StereoLink" font="~ NormalFontSmall" font-color="TextColor" back-color="EditBack" frame-color="EditFrame" text-alignment="center" value-precision="0" style-round-rect="true" round-rect-radius="4" origin="605, 280" size="46, 15"/>

	</template>
	<custom>
		<attributes name="UIDescFilePath" path="hyrax_editor.uidesc"/>
	</custom>
	<control-tags>
		<control-tag name="Threshold" tag="0"/>
		<control-tag name="Ceiling" tag="1"/>
		<control-tag name="LookAhead" tag="2"/>
		<control-tag name="Release" tag="3"/>
		<control-tag name="StereoLink" tag="4"/>
		<control-tag name="TruePeak" tag="5"/>
		<control-tag name="Bypass" tag="6"/>
	</control-tags>
</vstgui-ui-description>
